{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenTargets",
  "description": "OpenTargets evidence objects",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "datasourceId": {
          "const": "eva"
        },
        "alleleOrigins": {
          "$ref": "#/definitions/alleleOrigins"
        },
        "allelicRequirements": {
          "$ref": "#/definitions/allelicRequirements"
        },
        "clinicalSignificances": {
          "$ref": "#/definitions/clinicalSignificances"
        },
        "cohortPhenotypes": {
          "$ref": "#/definitions/cohortPhenotypes"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "datatypeId": {
          "$ref": "#/definitions/datatypeId"
        },
        "diseaseFromSource": {
          "$ref": "#/definitions/diseaseFromSource"
        },
        "diseaseFromSourceId": {
          "$ref": "#/definitions/diseaseFromSourceId"
        },
        "diseaseFromSourceMappedId": {
          "$ref": "#/definitions/diseaseFromSourceMappedId"
        },
        "literature": {
          "$ref": "#/definitions/literature"
        },
        "studyId": {
          "$ref": "#/definitions/studyId"
        },
        "targetFromSourceId": {
          "$ref": "#/definitions/targetFromSourceId"
        },
        "variantFunctionalConsequenceId": {
          "$ref": "#/definitions/variantFunctionalConsequenceId"
        },
        "variantHgvsId": {
          "$ref": "#/definitions/variantHgvsId"
        },
        "variantFromSourceId": {
          "$ref": "#/definitions/variantFromSourceId"
        },
        "variantId": {
          "$ref": "#/definitions/variantId"
        },
        "variantRsId": {
          "$ref": "#/definitions/variantRsId"
        },
        "releaseDate": {
          "$ref": "#/definitions/releaseDate"
        }
      },
      "required": [
        "clinicalSignificances",
        "cohortPhenotypes",
        "confidence",
        "datasourceId",
        "diseaseFromSource",
        "studyId",
        "targetFromSourceId",
        "variantFunctionalConsequenceId"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "datasourceId": {
          "const": "eva_somatic"
        },
        "alleleOrigins": {
          "$ref": "#/definitions/alleleOrigins"
        },
        "allelicRequirements": {
          "$ref": "#/definitions/allelicRequirements"
        },
        "clinicalSignificances": {
          "$ref": "#/definitions/clinicalSignificances"
        },
        "cohortPhenotypes": {
          "$ref": "#/definitions/cohortPhenotypes"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "datatypeId": {
          "$ref": "#/definitions/datatypeId"
        },
        "diseaseFromSource": {
          "$ref": "#/definitions/diseaseFromSource"
        },
        "diseaseFromSourceId": {
          "$ref": "#/definitions/diseaseFromSourceId"
        },
        "diseaseFromSourceMappedId": {
          "$ref": "#/definitions/diseaseFromSourceMappedId"
        },
        "literature": {
          "$ref": "#/definitions/literature"
        },
        "studyId": {
          "$ref": "#/definitions/studyId"
        },
        "targetFromSourceId": {
          "$ref": "#/definitions/targetFromSourceId"
        },
        "variantFunctionalConsequenceId": {
          "$ref": "#/definitions/variantFunctionalConsequenceId"
        },
        "variantHgvsId": {
          "$ref": "#/definitions/variantHgvsId"
        },
        "variantFromSourceId": {
          "$ref": "#/definitions/variantFromSourceId"
        },
        "variantId": {
          "$ref": "#/definitions/variantId"
        },
        "variantRsId": {
          "$ref": "#/definitions/variantRsId"
        },
        "releaseDate": {
          "$ref": "#/definitions/releaseDate"
        }
      },
      "required": [
        "alleleOrigins",
        "clinicalSignificances",
        "cohortPhenotypes",
        "confidence",
        "datasourceId",
        "diseaseFromSource",
        "studyId",
        "targetFromSourceId",
        "variantFunctionalConsequenceId"
      ],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "alleleOrigins": {
      "type": "array",
      "description": "Origin of the variant allele",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allelicRequirements": {
      "type": "array",
      "description": "Inheritance patterns",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "clinicalSignificances": {
      "type": "array",
      "description": "Standard terms to define clinical significance",
      "items": {
        "type": "string",
        "examples": [
          "pathogenic"
        ],
        "enum": [
          "affects",
          "association",
          "association not found",
          "benign",
          "confers sensitivity",
          "conflicting data from submitters",
          "conflicting interpretations of pathogenicity",
          "conflicting classifications of pathogenicity",
          "drug response",
          "established risk allele",
          "likely benign",
          "likely risk allele",
          "likely pathogenic",
          "low penetrance",
          "not provided",
          "other",
          "pathogenic",
          "protective",
          "risk factor",
          "uncertain risk allele",
          "uncertain significance",
          "evidence only",
          "vus-low",
          "vus-mid",
          "vus-high"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cohortPhenotypes": {
      "type": "array",
      "description": "Clinical features/phenotypes observed in studied individuals",
      "items": {
        "type": "string",
        "examples": [
          "Anterior segment dysgenesis 5"
        ]
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "string",
      "description": "Confidence qualifier on the reported evidence"
    },
    "datatypeId": {
      "type": "string",
      "enum": [
        "affected_pathway",
        "literature",
        "rna_expression",
        "genetic_literature",
        "animal_model",
        "somatic_mutation",
        "known_drug",
        "genetic_association",
        "ot_partner",
        "ot_validation_lab"
      ]
    },
    "diseaseFromSource": {
      "type": "string",
      "description": "Disease label from the original source",
      "examples": [
        "MYOPATHY, SPHEROID BODY"
      ]
    },
    "diseaseFromSourceId": {
      "type": "string",
      "description": "Disease ID from the original source",
      "examples": [
        "OMIM:182920"
      ]
    },
    "diseaseFromSourceMappedId": {
      "type": "string",
      "description": "Identifier of the disease in the EFO ontology",
      "pattern": "(^NCIT_|^Orphanet_|^GO_|^HP_|^EFO_|^MONDO_|^DOID_|^MP_|^OTAR_|^PATO_|^OBI_|^OBA_|^OGMS_|^GSSO_|^UBERON_)",
      "examples": [
        "EFO_0005537"
      ]
    },
    "literature": {
      "type": "array",
      "description": "PubMed or preprint reference identifiers",
      "items": {
        "type": "string",
        "pattern": "(PPR)?\\d+"
      },
      "uniqueItems": true
    },
    "releaseDate": {
      "type": "string",
      "description": "Date of the release of the data in a 'YYYY-MM-DD' format",
      "pattern": "(((19|20)([2468][048]|[13579][26]|0[48])|2000)[-]02[-]29|((19|20)[0-9]{2}[-](0[469]|11)[-](0[1-9]|[12][0-9]|30)|(19|20)[0-9]{2}[-](0[13578]|1[02])[-](0[1-9]|[12][0-9]|3[01])|(19|20)[0-9]{2}[-]02[-](0[1-9]|1[0-9]|2[0-8])))"
    },
    "studyId": {
      "type": "string",
      "description": "Identifier of the study",
      "examples": [
        "GCST90083260"
      ]
    },
    "targetFromSourceId": {
      "type": "string",
      "description": "Target ID in resource of origin (accepted sources include Ensembl gene ID, Uniprot ID, gene symbol), only capital letters are accepted.",
      "examples": [
        "BRCA1",
        "ENSG00000012048",
        "P38398"
      ],
      "pattern": "^[a-zA-Z0-9-.]+$"
    },
    "variantFunctionalConsequenceId": {
      "type": "string",
      "description": "Sequence ontology (SO) identifier of the functional consequence of the variant",
      "pattern": "SO_\\d+",
      "examples": [
        "SO_0001628"
      ]
    },
    "variantHgvsId": {
      "type": "string",
      "description": "Identifier in HGVS notation of the disease-causing variant.",
      "examples": [
        "NC_000011.10:g.17605796C>T",
        "LRG_214t1:c.889-1633_7395-667del"
      ]
    },
    "variantFromSourceId": {
      "type": "string",
      "description": "Identifier of the disease-causing variant at source.",
      "examples": [
        "NC_000011.10:g.17605796C>T",
        "VCV000018397"
      ]
    },
    "variantId": {
      "type": "string",
      "description": "Identifier in CHROM_POS_REF_ALT notation of the disease-causing variant.",
      "pattern": "^([0-9XY]{1,2}|MT)_\\d+_[A-Z]+_[A-Z]+$",
      "examples": [
        "20_41203988_T_C",
        "MT_91234_C_W"
      ]
    },
    "variantRsId": {
      "type": "string",
      "description": "Variant reference SNP cluster ID (Rsid)",
      "pattern": "^rs[0-9]{1,}$",
      "examples": [
        "rs539139475"
      ]
    }
  }
}
